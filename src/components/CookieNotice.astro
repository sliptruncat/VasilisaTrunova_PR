---
import { href, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
---
<div class="cookie window" data-cookie hidden role="region" aria-label={ru ? 'Уведомление о cookie' : 'Cookie notice'}>
  <div class="window__bar"><span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span><span>cookies.txt</span></div>
  <div class="cookie__body">
    <p>
      {ru
        ? 'Здесь нет рекламных и аналитических cookie. Браузер запомнит только, что вы закрыли это окно. '
        : 'No advertising or analytics cookies here. Your browser only remembers that you closed this window. '}
      <a href={href('privacy', lang)}>{ru ? 'Политика конфиденциальности' : 'Privacy policy'}</a>
    </p>
    <button class="btn cookie__ok" type="button" data-cookie-ok>{ru ? 'Понятно' : 'Got it'}</button>
  </div>
</div>

<script>
  const KEY = 'cookie-ok';
  document.addEventListener('astro:page-load', () => {
    const box = document.querySelector<HTMLElement>('[data-cookie]');
    if (!box) return;
    let accepted = false;
    try { accepted = localStorage.getItem(KEY) === '1'; } catch { /* storage blocked */ }
    if (accepted) return;
    box.hidden = false;
    box.querySelector('[data-cookie-ok]')?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch { /* storage blocked */ }
      box.hidden = true;
    }, { once: true });
  });
</script>

<style>
  .cookie { position: fixed; left: 20px; bottom: 20px; z-index: 60; width: min(380px, calc(100vw - 40px)); }
  .cookie__body { display: grid; gap: 14px; padding: 16px 18px 18px; font-size: 0.9rem; color: var(--text-soft); }
  .cookie__body a { color: var(--berry); }
  .cookie__ok { justify-self: start; min-height: 40px; padding: 0 20px; }
  @media (max-width: 560px) { .cookie { left: 12px; right: 12px; bottom: 12px; width: auto; } }
</style>
