---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import { services } from '@/data/services';
import { href, tr, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const formats = ru
  ? [['Отдельная задача', 'Аудит, стратегия, медиаплан, работа со СМИ или блогерами'], ['Проект полного цикла', 'От исследования до запуска и оценки результатов'], ['Долгосрочное сопровождение', 'Руководство направлением, команда и подрядчики'], ['Консультация', 'Взгляд со стороны и список конкретных изменений']]
  : [['A single task', 'An audit, strategy, media plan, media or influencer work'], ['A full-cycle project', 'From research to launch and evaluation'], ['Long-term support', 'Heading a function, team and contractors'], ['Consultation', 'An outside view and a list of concrete changes']];
---
<Base lang={lang} title={ru ? 'Услуги' : 'Services'} description={ru ? 'Услуги Василисы Труновой: PR-, коммуникационная и маркетинговая стратегия, позиционирование, СМИ, цифровое продвижение, блогеры, ивенты.' : 'Services: PR, communications and marketing strategy, positioning, media, digital, influencers, events.'}>
  <PageHero label="Services" title={ru ? 'Услуги' : 'Services'} lead={ru ? 'Описываю услуги через задачу бизнеса и результат. Стоимость обсуждаем под задачу.' : 'Each service is described through a business task and its outcome. Pricing depends on the task.'} />

  <section class="container section">
    <ul class="svc">
      {services.map((s, i) => (
        <li class="svc__item reveal">
          <span class="svc__n num">{String(i + 1).padStart(2, '0')}</span>
          <h2>{tr(s.title, lang)}</h2>
          <p class="svc__task"><span class="label">{ru ? 'Задача' : 'Task'}</span>{tr(s.task, lang)}</p>
          <p class="svc__out"><span class="label">{ru ? 'Результат' : 'Outcome'}</span>{tr(s.outcome, lang)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section">
    <h2 class="reveal fmt-h">{ru ? 'Форматы работы' : 'Ways to work together'}</h2>
    <ul class="fmt">{formats.map(([t, d], i) => <li class="reveal"><span class="num">0{i + 1}</span><strong>{t}</strong><span>{d}</span></li>)}</ul>
    <a class="link reveal" href={href('work', lang)}>{ru ? 'Посмотреть кейсы' : 'See the work'} <span class="arrow">↗</span></a>
  </section>

  <ContactBlock lang={lang} />
</Base>

<style>
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
  .svc__item { display: grid; gap: 12px; align-content: start; padding: 30px; background: var(--surface); transition: background 0.3s; }
  .svc__item:hover { background: var(--surface-2); }
  .svc__n { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--berry); color: #fffbf8; }
  .svc__item:nth-child(3n + 2) .svc__n { background: var(--wine); }
  .svc__item:nth-child(3n + 3) .svc__n { background: var(--mulberry); }
  .svc__item h2 { font-size: clamp(1.4rem, 1.9vw, 1.75rem); }
  .svc__task, .svc__out { display: grid; gap: 4px; }
  .svc__task { color: var(--text-soft); }
  .svc__out { font-weight: 500; }
  .fmt-h { margin-bottom: 24px; }
  .fmt { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap); }
  .fmt li { display: grid; gap: 8px; padding: 24px; border-radius: var(--r-md); border: 1px solid var(--line); }
  .fmt .num { color: var(--berry); font-size: 1.3rem; }
  .fmt strong { font: 500 1.25rem/1.2 var(--f-display); }
  .fmt span:last-child { color: var(--text-soft); font-size: 0.92rem; }
  @media (max-width: 1024px) { .svc { grid-template-columns: 1fr 1fr; } .fmt { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .svc, .fmt { grid-template-columns: 1fr; } }
</style>
