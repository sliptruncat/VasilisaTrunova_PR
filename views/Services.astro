---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import { services } from '@/data/services';
import { href, tr, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const formats = ru
  ? [['Аудит', 'Разобраться в текущем положении бренда, коммуникаций и каналов'], ['Исследование', 'Изучить рынок, аудиторию, конкурентов и точки роста'], ['Стратегия', 'Определить цели, позиционирование, каналы, KPI и план действий'], ['Кампания', 'Разработать и реализовать кампанию под конкретную задачу'], ['Запуск и продвижение', 'Вывести продукт, проект или событие к нужной аудитории'], ['Сопровождение', 'Взять на себя управление коммуникациями, командой и подрядчиками']]
  : [['Audit', 'Review the brand, communications and channels'], ['Research', 'Study the market, audience, competitors and growth opportunities'], ['Strategy', 'Define goals, positioning, channels, KPIs and action plan'], ['Campaign', 'Develop and deliver a campaign for a specific objective'], ['Launch & promotion', 'Bring a product, project or event to its audience'], ['Ongoing support', 'Manage communications, the team and suppliers']];
---
<Base lang={lang} title={ru ? 'Услуги' : 'Services'} description={ru ? 'Услуги Василисы Труновой: PR-, коммуникационная и маркетинговая стратегия, позиционирование, СМИ, цифровое продвижение, блогеры, ивенты.' : 'Services: PR, communications and marketing strategy, positioning, media, digital, influencers, events.'}>
  <PageHero label="Services" title={ru ? 'Услуги' : 'Services'} lead={ru ? 'Описываю услуги через задачу бизнеса и результат. Стоимость обсуждаем под задачу.' : 'Each service is described through a business task and its outcome. Pricing depends on the task.'} />

  <!-- CONSULTATION BOOKING -->
  <section class="container section booking" id="booking">
    <div class="section-head">
      <div>
        <span class="label label--line reveal">{ru ? 'Индивидуальная работа' : 'One-to-one'}</span>
        <h2 class="reveal">{ru ? 'Записаться на консультацию' : 'Book a consultation'}</h2>
        <p class="reveal booking__lead">{ru ? 'Выберите формат, дату и удобное время. Стоимость и состав консультаций пока предварительные.' : 'Choose a format, date and time. Consultation details and pricing are preliminary.'}</p>
      </div>
    </div>
    <div class="booking__packages" role="group" aria-label={ru ? 'Формат консультации' : 'Consultation format'}>
      <button class="booking-package is-selected" type="button" data-package="intro" data-duration="20">
        <span class="booking-package__duration">{ru ? '15–20 минут' : '15–20 min'}</span>
        <strong>{ru ? 'Первичное знакомство' : 'Intro call'}</strong>
        <b>{ru ? 'Бесплатно' : 'Free'}</b>
        <small>{ru ? 'Коротко обсудить запрос и понять, подходим ли мы друг другу' : 'Briefly discuss your request and see if we are a good fit'}</small>
      </button>
      <button class="booking-package" type="button" data-package="30" data-duration="30">
        <span class="booking-package__duration">30 {ru ? 'минут' : 'min'}</span>
        <strong>{ru ? 'Точечная консультация' : 'Focused consultation'}</strong>
        <b>{ru ? '5 559 ₽' : 'RUB 5,559'}</b>
        <small>{ru ? 'Предварительная стоимость' : 'Preliminary price'}</small>
      </button>
      <button class="booking-package" type="button" data-package="60" data-duration="60">
        <span class="booking-package__duration">60 {ru ? 'минут' : 'min'}</span>
        <strong>{ru ? 'Разбор задачи' : 'In-depth session'}</strong>
        <b>{ru ? '7 499 ₽' : 'RUB 7,499'}</b>
        <small>{ru ? 'Предварительная стоимость' : 'Preliminary price'}</small>
      </button>
      <button class="booking-package" type="button" data-package="strategy" data-duration="120">
        <span class="booking-package__duration">90–120 {ru ? 'минут' : 'min'}</span>
        <strong>{ru ? 'Консультация + стратегия' : 'Consultation + strategy'}</strong>
        <b>{ru ? '30 000 ₽' : 'RUB 30,000'}</b>
        <small>{ru ? 'Предварительная стоимость' : 'Preliminary price'}</small>
      </button>
    </div>
    <div class="booking__planner reveal">
      <div class="booking__calendar">
        <label class="booking__label" for="consult-date">{ru ? 'Выберите дату' : 'Choose a date'}</label>
        <input id="consult-date" class="booking__date" type="date" />
        <p class="booking__timezone">{ru ? 'Время отображается по часовому поясу вашего устройства.' : 'Times are shown in your device time zone.'}</p>
        <div class="booking__hours">
          <span>{ru ? 'Доступное время' : 'Available hours'}</span>
          <b>12:00–16:00</b>
          <b>18:00–23:30</b>
        </div>
      </div>
      <div class="booking__slots-wrap">
        <div class="booking__slots-head">
          <span class="booking__label">{ru ? 'Свободные слоты' : 'Available slots'}</span>
          <span class="booking__duration" data-selected-duration>{ru ? '20 минут' : '20 minutes'}</span>
        </div>
        <div class="booking__slots" data-slots aria-live="polite"></div>
        <p class="booking__selected" data-booking-summary>{ru ? 'Выберите дату и время' : 'Choose a date and time'}</p>
        <button class="btn booking__submit" type="button" data-booking-submit disabled>{ru ? 'Продолжить к заявке' : 'Continue to enquiry'} <span class="arrow">↘</span></button>
        <p class="booking__disclaimer">{ru ? 'Слоты пока демонстрационные. Выбранное время не бронируется автоматически: окончательное подтверждение придёт после согласования заявки.' : 'Slots are currently indicative. Selecting a time does not reserve it; the appointment is confirmed after your request is reviewed.'}</p>
      </div>
    </div>
  </section>

  <!-- PRODUCTS & MATERIALS -->
  <section class="container section product-library" id="products">
    <div class="section-head">
      <div>
        <span class="label label--line reveal">{ru ? 'Авторские материалы' : 'Resources'}</span>
        <h2 class="reveal">{ru ? 'Продукты и материалы' : 'Products & resources'}</h2>
        <p class="reveal product-library__lead">{ru
          ? 'Практические материалы, в которых мой опыт и методики превращаются в инструменты для самостоятельной работы.'
          : 'Practical resources that turn my experience and methods into tools for independent work.'}</p>
      </div>
    </div>
    <div class="product-library__tabs" role="tablist" aria-label={ru ? 'Категории продуктов' : 'Product categories'}>
      <button class="product-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="free-products" data-product-tab="free">{ru ? 'Бесплатные продукты' : 'Free resources'}</button>
      <button class="product-tab" type="button" role="tab" aria-selected="false" aria-controls="paid-products" data-product-tab="paid">{ru ? 'Платные продукты' : 'Paid products'}</button>
    </div>
    <div class="product-panel is-active" id="free-products" role="tabpanel" data-product-panel="free">
      <div class="product-list">
        <button class="product-entry" type="button" aria-expanded="false" data-product-entry="free-checklists">
          <span class="product-entry__number">01</span>
          <span class="product-entry__copy"><strong>{ru ? 'Чек-листы и полезные материалы' : 'Checklists & practical resources'}</strong><small>{ru ? 'Короткие инструменты для самостоятельной работы' : 'Quick tools for independent work'}</small></span>
          <span class="product-entry__toggle">+</span>
        </button>
        <div class="product-detail" data-product-detail="free-checklists" hidden>
          <p>{ru ? 'Подборки вопросов, критерии проверки и небольшие инструкции по PR, маркетингу и коммуникациям. Состав и файлы добавим позже.' : 'Question sets, review criteria and short guides on PR, marketing and communications. Details and files will be added later.'}</p>
          <span class="product-detail__status">{ru ? 'Материалы готовятся' : 'Coming soon'}</span>
        </div>
        <button class="product-entry" type="button" aria-expanded="false" data-product-entry="free-channel">
          <span class="product-entry__number">02</span>
          <span class="product-entry__copy"><strong>{ru ? 'Telegram-канал' : 'Telegram channel'}</strong><small>{ru ? 'Заметки, разборы, инструменты и наблюдения' : 'Notes, case breakdowns, tools and observations'}</small></span>
          <span class="product-entry__toggle">+</span>
        </button>
        <div class="product-detail" data-product-detail="free-channel" hidden>
          <p>{ru ? 'Канал о коммуникациях, продвижении и работе с проектами. Ссылку добавим после запуска.' : 'A channel about communications, promotion and project work. The link will be added after launch.'}</p>
          <span class="product-detail__status">{ru ? 'Скоро запустим' : 'Launching soon'}</span>
        </div>
      </div>
    </div>
    <div class="product-panel" id="paid-products" role="tabpanel" data-product-panel="paid" hidden>
      <div class="product-list">
        <button class="product-entry" type="button" aria-expanded="false" data-product-entry="paid-guides">
          <span class="product-entry__number">01</span>
          <span class="product-entry__copy"><strong>{ru ? 'Гайды и авторские методики' : 'Guides & original methods'}</strong><small>{ru ? 'PDF-разборы, инструкции и практические руководства' : 'PDF breakdowns, instructions and practical playbooks'}</small></span>
          <span class="product-entry__toggle">+</span>
        </button>
        <div class="product-detail" data-product-detail="paid-guides" hidden>
          <p>{ru ? 'Подробные материалы по аудиту, стратегии, PR и маркетингу. Позже добавим описание каждого продукта, программу, формат и стоимость.' : 'In-depth resources on audits, strategy, PR and marketing. Product descriptions, contents, format and pricing will be added later.'}</p>
          <span class="product-detail__status">{ru ? 'В разработке' : 'In development'}</span>
        </div>
        <button class="product-entry" type="button" aria-expanded="false" data-product-entry="paid-templates">
          <span class="product-entry__number">02</span>
          <span class="product-entry__copy"><strong>{ru ? 'Шаблоны и рабочие документы' : 'Templates & workbooks'}</strong><small>{ru ? 'Структуры аудитов, брифы, таблицы и инструменты планирования' : 'Audit frameworks, briefs, spreadsheets and planning tools'}</small></span>
          <span class="product-entry__toggle">+</span>
        </button>
        <div class="product-detail" data-product-detail="paid-templates" hidden>
          <p>{ru ? 'Практические файлы для специалистов и команд. Позже добавим примеры, состав комплектов и условия приобретения.' : 'Practical files for professionals and teams. Previews, bundle contents and purchase details will be added later.'}</p>
          <span class="product-detail__status">{ru ? 'В разработке' : 'In development'}</span>
        </div>
      </div>
    </div>
  </section>

<script>
  document.addEventListener('astro:page-load', () => {
    const library = document.querySelector<HTMLElement>('#products');
    if (library && !library.dataset.ready) {
      library.dataset.ready = '1';
      const tabs = [...library.querySelectorAll<HTMLButtonElement>('[data-product-tab]')];
      const panels = [...library.querySelectorAll<HTMLElement>('[data-product-panel]')];
      tabs.forEach(tab => tab.addEventListener('click', () => {
        const key = tab.dataset.productTab;
        tabs.forEach(t => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach(panel => {
          const active = panel.dataset.productPanel === key;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      }));
      library.querySelectorAll<HTMLButtonElement>('[data-product-entry]').forEach(entry => entry.addEventListener('click', () => {
        const key = entry.dataset.productEntry;
        const detail = library.querySelector<HTMLElement>('[data-product-detail="' + key + '"]');
        if (!detail) return;
        const expanded = entry.getAttribute('aria-expanded') === 'true';
        entry.setAttribute('aria-expanded', String(!expanded));
        detail.hidden = expanded;
        entry.querySelector('.product-entry__toggle')!.textContent = expanded ? '+' : '−';
      }));
    }
    const root = document.querySelector<HTMLElement>('#booking');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const dateInput = root.querySelector<HTMLInputElement>('#consult-date');
    const slotsEl = root.querySelector<HTMLElement>('[data-slots]');
    const summary = root.querySelector<HTMLElement>('[data-booking-summary]');
    const submit = root.querySelector<HTMLButtonElement>('[data-booking-submit]');
    const durationLabel = root.querySelector<HTMLElement>('[data-selected-duration]');
    const packages = [...root.querySelectorAll<HTMLButtonElement>('[data-package]')];
    if (!dateInput || !slotsEl || !summary || !submit || !durationLabel) return;
    const ru = document.documentElement.lang === 'ru';
    const today = new Date();
    const toLocal = (d: Date) => [d.getFullYear(), String(d.getMonth()+1).padStart(2,'0'), String(d.getDate()).padStart(2,'0')].join('-');
    dateInput.min = toLocal(today);
    dateInput.value = toLocal(today);
    let selectedPackage = 'intro';
    let duration = 20;
    let selectedTime = '';
    const getDateLabel = (value: string) => new Date(value + 'T12:00:00').toLocaleDateString(ru ? 'ru-RU' : 'en-GB', { day:'numeric', month:'long', year:'numeric' });
    const renderSlots = () => {
      selectedTime = '';
      summary.textContent = ru ? 'Выберите удобное время' : 'Choose a time that works for you';
      submit.disabled = true;
      durationLabel.textContent = ru ? (duration === 20 ? '15–20 минут' : duration + ' минут') : (duration === 20 ? '15–20 minutes' : duration + ' minutes');
      const times = [];
      for (let m=12*60; m<16*60; m+=30) times.push(m);
      for (let m=18*60; m<=23*60; m+=30) times.push(m);
      times.push(23*60+30);
      slotsEl.replaceChildren();
      times.forEach((m) => {
        const end = m + duration;
        const inAfternoon = m >= 12*60 && m < 16*60 && end <= 16*60;
        const inEvening = m >= 18*60 && end <= 23*60+30;
        if (!inAfternoon && !inEvening) return;
        const h = String(Math.floor(m/60)).padStart(2,'0');
        const min = String(m%60).padStart(2,'0');
        const time = h+':'+min;
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'booking-slot'; b.textContent = time;
        b.addEventListener('click', () => {
          slotsEl.querySelectorAll('.booking-slot').forEach(x => x.classList.remove('is-selected'));
          b.classList.add('is-selected');
          selectedTime = time;
          summary.textContent = (ru ? 'Вы выбрали: ' : 'Selected: ') + getDateLabel(dateInput.value) + ', ' + time;
          submit.disabled = false;
        });
        slotsEl.append(b);
      });
      if (!slotsEl.children.length) slotsEl.textContent = ru ? 'На эту дату нет подходящих слотов.' : 'No suitable slots for this date.';
    };
    packages.forEach((b) => b.addEventListener('click', () => {
      packages.forEach(x => x.classList.toggle('is-selected', x === b));
      selectedPackage = b.dataset.package ?? 'intro';
      duration = Number(b.dataset.duration ?? 20);
      renderSlots();
    }));
    dateInput.addEventListener('change', renderSlots);
    submit.addEventListener('click', () => {
      if (!selectedTime) return;
      const packageName = packages.find(x => x.dataset.package === selectedPackage)?.querySelector('strong')?.textContent ?? selectedPackage;
      const message = (ru ? 'Запрос на консультацию: ' : 'Consultation request: ') + packageName + '; ' + getDateLabel(dateInput.value) + ', ' + selectedTime + '.';
      const contact = document.querySelector<HTMLElement>('#contact');
      const textarea = contact?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
      if (textarea) textarea.value = message + (ru ? '\\n\\nМой запрос: ' : '\\n\\nMy request: ');
      contact?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      textarea?.focus({ preventScroll: true });
    });
    renderSlots();
  });
</script>


  <section class="container section">
    <ul class="svc">
      {services.map((s, i) => (
        <li class="svc__item reveal">
          <span class="svc__n num">{String(i + 1).padStart(2, '0')}</span>
          <h2>{tr(s.title, lang)}</h2>
          <p class="svc__task"><span class="label">{ru ? 'Задача' : 'Task'}</span>{tr(s.task, lang)}</p>
          <p class="svc__out"><span class="label">{ru ? 'Результат' : 'Outcome'}</span>{tr(s.outcome, lang)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section">
    <h2 class="reveal fmt-h">{ru ? 'Форматы сотрудничества' : 'Ways to work together'}</h2>
    <ul class="fmt">{formats.map(([t, d], i) => <li class="reveal"><span class="num">0{i + 1}</span><strong>{t}</strong><span>{d}</span></li>)}</ul>
    <a class="link reveal" href={href('work', lang)}>{ru ? 'Посмотреть кейсы' : 'See the work'} <span class="arrow">↗</span></a>
  </section>

  <ContactBlock lang={lang} />
</Base>

<style>
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
  .svc__item { display: grid; gap: 12px; align-content: start; padding: 30px; background: var(--surface); transition: background 0.3s; }
  .svc__item:hover { background: var(--surface-2); }
  .svc__n { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--berry); color: #fffbf8; }
  .svc__item:nth-child(3n + 2) .svc__n { background: var(--wine); }
  .svc__item:nth-child(3n + 3) .svc__n { background: var(--mulberry); }
  .svc__item h2 { font-size: clamp(1.4rem, 1.9vw, 1.75rem); }
  .svc__task, .svc__out { display: grid; gap: 4px; }
  .svc__task { color: var(--text-soft); }
  .svc__out { font-weight: 500; }
  .fmt-h { margin-bottom: 24px; }
  .fmt { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .fmt li { display: grid; gap: 8px; padding: 24px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--surface); }
  .fmt .num { color: var(--berry); font-size: 1.3rem; }
  .fmt strong { font: 500 1.25rem/1.2 var(--f-display); }
  .fmt span:last-child { color: var(--text-soft); font-size: 0.92rem; }
  .product-library__lead { max-width: 46rem; color: var(--text-soft); }
  .product-library__tabs { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 22px; border-bottom: 1px solid var(--line); }
  .product-tab { position: relative; padding: 14px 20px; border: 0; background: transparent; color: var(--text-soft); cursor: pointer; font: 500 1rem var(--f-body); }
  .product-tab::after { content: ''; position: absolute; right: 18px; bottom: -1px; left: 18px; height: 2px; background: transparent; }
  .product-tab.is-active { color: var(--wine); }
  .product-tab.is-active::after { background: var(--berry); }
  .product-panel[hidden], .product-detail[hidden] { display: none; }
  .product-list { border-top: 1px solid var(--line); }
  .product-entry { display: grid; grid-template-columns: 54px 1fr 28px; gap: 16px; align-items: center; width: 100%; padding: 22px 8px; text-align: left; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--text); cursor: pointer; }
  .product-entry:hover { background: var(--surface-2); }
  .product-entry__number { color: var(--berry); font: 500 1.15rem var(--f-display); }
  .product-entry__copy { display: grid; gap: 5px; }
  .product-entry__copy strong { font: 500 1.2rem/1.25 var(--f-display); }
  .product-entry__copy small { color: var(--text-soft); font-size: .88rem; }
  .product-entry__toggle { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--line-strong); border-radius: 50%; font-size: 1.1rem; }
  .product-detail { padding: 0 52px 22px 78px; border-bottom: 1px solid var(--line); color: var(--text-soft); }
  .product-detail p { max-width: 48rem; margin: 0 0 12px; font-size: .94rem; line-height: 1.65; }
  .product-detail__status { color: var(--berry); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  .booking__lead { max-width: 44rem; color: var(--text-soft); }
  .booking__packages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 28px 0; }
  .booking-package { display: grid; gap: 10px; align-content: start; text-align: left; padding: 22px; min-height: 190px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); color: var(--text); cursor: pointer; transition: border-color .2s, background .2s, transform .2s; }
  .booking-package:hover { transform: translateY(-3px); border-color: var(--berry); }
  .booking-package.is-selected { border: 2px solid var(--berry); background: var(--surface-2); padding: 21px; }
  .booking-package__duration { color: var(--berry); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .booking-package strong { font: 500 1.2rem/1.2 var(--f-display); }
  .booking-package b { font-size: 1.2rem; }
  .booking-package small { color: var(--text-mute); font-size: .82rem; }
  .booking__planner { display: grid; grid-template-columns: minmax(230px,.8fr) 1.2fr; gap: 30px; padding: clamp(20px,3vw,32px); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface-2); }
  .booking__label { display: block; font-weight: 600; margin-bottom: 12px; }
  .booking__date { width: 100%; min-height: 48px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 10px; background: var(--surface); color: var(--text); font: inherit; }
  .booking__timezone, .booking__disclaimer { color: var(--text-mute); font-size: .8rem; line-height: 1.5; }
  .booking__hours { display: grid; gap: 8px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .88rem; }
  .booking__hours span { color: var(--text-soft); }
  .booking__slots-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; }
  .booking__duration { color: var(--berry); font-size: .86rem; }
  .booking__slots { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; }
