---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Window from '@/components/Window.astro';
import CaseFolder from '@/components/CaseFolder.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import FaqFlip from '@/components/FaqFlip.astro';
import MatchCards from '@/components/MatchCards.astro';
import Publications from '@/components/Publications.astro';
import { href, tr, useT, type Lang } from '@/i18n/ui';
import { approach, hero, intro, stats, contacts, teaching, moreWork } from '@/data/site';
import { projects } from '@/data/projects';
import { roles, timelineYears } from '@/data/experience';
import { services } from '@/data/services';
import { skillGroups } from '@/data/skills';
import { degrees, certificates } from '@/data/education';
import { testimonials } from '@/data/testimonials';
import portrait from '@/assets/img/me/portrait.jpg';
import eventPhoto from '@/assets/img/me/event-neon.jpg';
import testdrive from '@/assets/img/me/testdrive.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const ru = lang === 'ru';

const copy = {
  selected: { ru: 'Избранные кейсы', en: 'Selected work' },
  selectedNote: { ru: 'Наведите на папку, чтобы заглянуть внутрь. Внутри — задача, стратегия, реализация и результаты.', en: 'Hover over a folder to peek inside: the challenge, strategy, execution and results.' },
  more: { ru: 'Ещё проекты', en: 'More projects' },
  what: { ru: 'Что делала', en: 'What I did' },
  numbers: { ru: 'Опыт в цифрах', en: 'Experience in numbers' },
  timeline: { ru: 'Таймлайн', en: 'Timeline' },
  pick: { ru: 'Нажмите на год, чтобы увидеть, чем я занималась', en: 'Pick a year to see what I was doing' },
  services: { ru: 'Услуги и форматы сотрудничества', en: 'Services & ways to work together' },
  allServices: { ru: 'Все услуги', en: 'All services' },
  skills: { ru: 'Навыки и инструменты', en: 'Skills & tools' },
  education: { ru: 'Образование и события', en: 'Education & events' },
  testimonials: { ru: 'Из рекомендательных писем', en: 'From recommendation letters' },
  photoAlt: { ru: 'Портрет Василисы Труновой', en: 'Portrait of Vasilisa Trunova' },
  eventAlt: { ru: 'Василиса на мероприятии', en: 'Vasilisa at an event' },
};
const currentYear = 2026;
const kindLabel = {
  work: { ru: 'Работа', en: 'Work' }, project: { ru: 'Проект', en: 'Project' },
  education: { ru: 'Учёба', en: 'Education' }, teaching: { ru: 'Преподавание', en: 'Teaching' },
};
const cvUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${contacts.cv}`;
const yearCount = (y: number) => roles.filter((r) => r.years.includes(y)).length;
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="hero container">
    <div class="hero__text">
      <p class="label label--line reveal">{tr(hero.eyebrow, lang)}</p>
      <h1 class="hero__title" aria-label={ru ? 'Василиса Трунова' : 'Vasilisa Trunova'}>
        <span class="hero__line reveal">{ru ? 'Василиса' : 'Vasilisa'}<span class="star" aria-hidden="true">✳</span></span>
        <span class="hero__line reveal">{ru ? 'Трунова' : 'Trunova'}</span>
      </h1>
      <p class="lead reveal">{tr(hero.lead, lang)}</p>
      <blockquote class="hero__quote reveal">
        <span class="hero__quote-mark" aria-hidden="true">“</span>
        <p>{ru ? 'Сначала стратегия, потом контент.' : 'Strategy first, content second.'}</p>
      </blockquote>
      <div class="hero__cta reveal">
        <a class="btn" href="#work">{t('cta.cases')} <span class="arrow">↘</span></a>
        <a class="btn btn--ghost" href={href('about', lang)}>{t('cta.about')}</a>
        <a class="btn btn--ghost" href={cvUrl} download>{ru ? 'Резюме PDF' : 'CV (PDF)'} <span class="arrow arrow--down">↓</span></a>
      </div>
    </div>
    <div class="hero__visual reveal">
      <Window class="hero__window" bodyClass="hero__window-body" title="vasilisa_trunova.jpg">
        <Image src={portrait} alt={tr(copy.photoAlt, lang)} widths={[480, 760, 1100]} sizes="(max-width: 768px) 84vw, 40vw" loading="eager" fetchpriority="high" class="hero__photo" />
      </Window>
      <ul class="hero__contacts" aria-label={t('nav.contact')}>
        <li><a href={`mailto:${contacts.email}`}><span class="ico" aria-hidden="true">✉</span>{contacts.email}</a></li>
        <li><a href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener"><span class="ico" aria-hidden="true">✈</span>@{contacts.telegram}</a></li>
      </ul>
    </div>
  </section>

  <!-- SELECTED WORK: folders -->
  <section class="container section" id="work">
    <div class="section-head">
      <div>
        <span class="label label--line reveal">Work</span>
        <h2 class="reveal">{tr(copy.selected, lang)}</h2>
        <p class="reveal">{tr(copy.selectedNote, lang)}</p>
      </div>
      <a class="link reveal" href={href('work', lang)}>{t('cta.allProjects')} <span class="arrow">↗</span></a>
    </div>
    <ul class="folders">
      {projects.map((p) => <li class="reveal"><CaseFolder project={p} lang={lang} /></li>)}
    </ul>

    <!-- smaller projects as windows -->
    <h3 class="more__title reveal">{tr(copy.more, lang)}</h3>
    <ul class="more">
      {moreWork.map((w) => (
        <li class="reveal">
          <Window title={`${w.file}.txt`} class:list={['mw', w.accent && 'mw--accent']} bodyClass="mw__body">
            <span class="chip chip--accent mw__tag">{tr(w.tag, lang)}</span>
            <h3>{tr(w.title, lang)}</h3>
            <p class="mw__role">{tr(w.role, lang)}</p>
            <p class="mw__text">{tr(w.text, lang)}</p>
            <details>
              <summary>{tr(copy.what, lang)}</summary>
              <ul>{tr(w.details, lang).map((d) => <li>{d}</li>)}</ul>
            </details>
            <ul class="mw__metrics">{tr(w.metrics, lang).map((m) => <li>{m}</li>)}</ul>
          </Window>
        </li>
      ))}
    </ul>
  </section>

  <!-- INTRO -->
  <section class="container section intro">
    <div class="intro__media reveal">
      <Image src={eventPhoto} alt={tr(copy.eventAlt, lang)} widths={[400, 700]} sizes="(max-width: 768px) 88vw, 34vw" loading="lazy" />
      <span class="intro__tag hand">PR · events · media</span>
    </div>
    <div class="intro__text">
      <p class="label label--line reveal">{t('nav.about')}</p>
      <h2 class="reveal">{tr(intro.title, lang)}</h2>
      <p class="lead reveal">{tr(intro.text, lang)}</p>
      <a class="link reveal" href={href('about', lang)}>{t('cta.more')} <span class="arrow">↗</span></a>
    </div>
  </section>

  <!-- NUMBERS + TIMELINE -->
  <section class="container section dash">
    <div class="dash__stats">
      <h2 class="reveal">{tr(copy.numbers, lang)}</h2>
      <ul class="stats">
        {stats.map((s) => (
          <li class:list={['stat', `tone-${s.tone}`, 'reveal']}>
            <b class="stat__value display" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</b>
            <span>{tr(s.label, lang)}</span>
          </li>
        ))}
      </ul>
    </div>
    <Window title={tr(copy.timeline, lang)} class="timeline reveal" bodyClass="timeline__body">
      <div class="timeline__range num" aria-hidden="true">{timelineYears[0]} — {currentYear}</div>
      <p class="timeline__hint">{tr(copy.pick, lang)}</p>
      <div class="timeline__years" data-years>
        {timelineYears.map((y) => (
          <button type="button" class="timeline__year num" aria-expanded="false" aria-controls="year-panel" data-year={y}>
            {y}<span class="timeline__dot" aria-hidden="true">{yearCount(y)}</span>
          </button>
        ))}
      </div>
      <div class="timeline__drop" id="year-panel" data-drop>
        <div class="timeline__drop-inner">
          <p class="timeline__drop-head num" data-drop-head></p>
          <ul class="timeline__list">
            {roles.map((r) => (
              <li data-role-years={r.years.join(',')} hidden>
                <span class="label">{tr(kindLabel[r.kind], lang)} · {tr(r.period, lang)}</span>
                <strong>{tr(r.org, lang)}</strong>
                <span>{tr(r.role, lang)}</span>
                <ul class="timeline__points">{tr(r.points, lang).map((pt) => <li>{pt}</li>)}</ul>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a class="link timeline__more" href={href('experience', lang)}>{t('nav.experience')} <span class="arrow">↗</span></a>
    </Window>
  </section>

  <!-- APPROACH (style of the first portfolio) -->
  <section class="container section">
    <div class="section-head"><div><span class="label label--line reveal">{ru ? 'Подход' : 'Approach'}</span><h2 class="reveal">{tr(approach.title, lang)}</h2></div></div>
    <ol class="steps">
      {approach.steps.map((s) => <li class="reveal"><h3>{tr(s.title, lang)}</h3><p>{tr(s.text, lang)}</p></li>)}
    </ol>
  </section>

  <!-- SERVICES -->
  <section class="container section">
    <div class="section-head">
      <div><span class="label label--line reveal">Services</span><h2 class="reveal">{tr(copy.services, lang)}</h2></div>
      <a class="link reveal" href={href('services', lang)}>{tr(copy.allServices, lang)} <span class="arrow">↗</span></a>
    </div>
    <p class="services__intro reveal">{ru
      ? 'Можно подключиться к отдельной задаче или пройти весь путь вместе: от исследования и постановки целей до запуска и оценки результата.'
      : 'I can join for a focused task or lead the whole process: from research and goal-setting to launch and evaluation.'}</p>
    <ul class="service-formats">
      {(ru ? [
        ['Аудит и исследование', 'Разобраться, что происходит с брендом, рынком и коммуникациями.', 'Анализ аудитории, конкурентов, позиционирования, каналов и текущих показателей. На выходе: выводы, приоритеты и рекомендации.'],
        ['Стратегия', 'Понять, куда двигаться и на чём сосредоточить ресурсы.', 'Коммуникационная или маркетинговая стратегия: цели, аудитории, сообщения, каналы, KPI, бюджет и план реализации.'],
        ['Кампания под ключ', 'Решить конкретную задачу в заданные сроки.', 'Разработка концепции и механики кампании, медиаплан, контент, работа со СМИ и блогерами, координация подрядчиков и оценка результатов.'],
        ['Запуск и продвижение', 'Вывести продукт, проект или событие к своей аудитории.', 'План запуска, рекламные размещения, контент, PR, партнёрства и сопровождение продвижения.'],
        ['Сопровождение и управление', 'Нужен человек, который держит коммуникации и процессы в руках.', 'Ведение проекта или направления, управление командой и подрядчиками, контроль сроков, бюджета, KPI и отчётности.'],
        ['Консультация', 'Нужен экспертный взгляд и понятный следующий шаг.', 'Разбор ситуации, ответы на вопросы, оценка гипотез и конкретный план действий по итогам встречи.'],
      ] : [
        ['Audit & research', 'Understand what is happening with the brand, market and communications.', 'Audience, competitor, positioning, channel and performance analysis. Deliverable: findings, priorities and recommendations.'],
        ['Strategy', 'Decide where to go and how to focus resources.', 'Communications or marketing strategy: goals, audiences, messages, channels, KPIs, budget and implementation roadmap.'],
        ['Campaign delivery', 'Solve a specific challenge within a clear timeline.', 'Campaign concept and mechanics, media plan, content, media and creator relations, supplier coordination and performance review.'],
        ['Launch & promotion', 'Bring a product, project or event to its audience.', 'Launch plan, paid placements, content, PR, partnerships and promotion management.'],
        ['Ongoing support & management', 'Bring in someone to own communications and keep delivery on track.', 'Project or function management, team and supplier coordination, timelines, budget, KPIs and reporting.'],
        ['Consultation', 'Get an expert perspective and a clear next step.', 'Situation review, questions answered, hypothesis assessment and an actionable plan after the meeting.'],
      ]).map((f, i) => (
        <li class="service-format reveal">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{f[0]}</h3>
          <p class="service-format__task">{f[1]}</p>
          <p>{f[2]}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- PRODUCTS / DIGITAL MATERIALS -->
  <section class="container section products" id="products">
    <div class="section-head">
      <div>
        <span class="label label--line reveal">{ru ? 'Авторские материалы' : 'Resources'}</span>
        <h2 class="reveal">{ru ? 'Продукты и материалы' : 'Products & resources'}</h2>
        <p class="reveal products__lead">{ru
          ? 'Практические материалы, в которых мой опыт и методики превращаются в инструменты для самостоятельной работы.'
          : 'Practical resources that turn my experience and methods into tools for independent work.'}</p>
      </div>
    </div>
    <div class="products__grid">
      <article class="product-card product-card--featured reveal">
        <span class="product-card__type">{ru ? 'Скоро' : 'Coming soon'}</span>
        <span class="product-card__index display">01</span>
        <h3>{ru ? 'Гайды и методики' : 'Guides & methods'}</h3>
        <p>{ru ? 'PDF-разборы, авторские инструкции и рабочие подходы к PR, маркетингу и коммуникациям.' : 'PDF guides, original playbooks and practical approaches to PR, marketing and communications.'}</p>
        <span class="product-card__note">{ru ? 'Материалы готовятся к публикации' : 'Resources are in preparation'}</span>
      </article>
      <article class="product-card reveal">
        <span class="product-card__type">{ru ? 'Скоро' : 'Coming soon'}</span>
        <span class="product-card__index display">02</span>
        <h3>{ru ? 'Шаблоны и рабочие документы' : 'Templates & workbooks'}</h3>
        <p>{ru ? 'Структуры аудитов, брифы, таблицы, чек-листы и инструменты для планирования кампаний.' : 'Audit frameworks, briefs, spreadsheets, checklists and campaign planning tools.'}</p>
        <span class="product-card__note">{ru ? 'Раздел будет пополняться' : 'More resources will be added'}</span>
      </article>
      <article class="product-card product-card--channel reveal">
        <span class="product-card__type">{ru ? 'В разработке' : 'In the works'}</span>
        <span class="product-card__index display">03</span>
        <h3>{ru ? 'Telegram-канал' : 'Telegram channel'}</h3>
        <p>{ru ? 'Заметки о коммуникациях, разборы кейсов, инструменты, наблюдения и материалы, которые не вошли в портфолио.' : 'Notes on communications, case breakdowns, tools, observations and resources beyond the portfolio.'}</p>
        <span class="product-card__note">{ru ? 'Скоро запустим' : 'Launching soon'}</span>
      </article>
    </div>
  </section>

  <!-- TEACHING (from the first portfolio) -->
  <section class="container section">
    <div class="section-head"><div><span class="label label--line reveal">{ru ? 'Лекции и наставничество' : 'Teaching & mentoring'}</span><h2 class="reveal">{tr(teaching.title, lang)}</h2></div></div>
    <div class="teach-grid">
      {teaching.items.map((x) => (
        <div class="teach reveal"><b class="display">{x.n}</b><h3>{tr(x.title, lang)}</h3><p>{tr(x.text, lang)}</p></div>
      ))}
      <figure class="teach teach--photo reveal">
        <Image src={testdrive} alt={tr(teaching.photoCaption, lang)} widths={[500, 800]} sizes="(max-width: 768px) 92vw, 40vw" loading="lazy" />
        <figcaption>{tr(teaching.photoCaption, lang)}</figcaption>
      </figure>
    </div>
  </section>

  <Publications lang={lang} />

  <!-- SKILLS + EDUCATION previews -->
  <section class="container section previews">
    <a class="preview reveal" href={href('skills', lang)}>
      <h2>{tr(copy.skills, lang)}</h2>
      <ul class="chips">{skillGroups.flatMap((g) => g.tools).slice(0, 12).map((tool) => <li class="chip">{tool}</li>)}</ul>
      <span class="preview__go" aria-hidden="true"><span class="arrow">↗</span></span>
    </a>
    <a class="preview preview--accent reveal" href={href('education', lang)}>
      <h2>{tr(copy.education, lang)}</h2>
      <ul class="preview__list">{degrees.map((d) => <li><span class="num">{tr(d.period, lang)}</span>{tr(d.title, lang)} — {tr(d.detail, lang)}</li>)}</ul>
      <div class="preview__certs">
        <span class="num">{ru ? '6 удостоверений о повышении квалификации · РАНХиГС, 2025' : '6 professional development certificates · RANEPA, 2025'}</span>
        <ul class="chips">{certificates.map((c) => <li class="chip">{tr(c.title, lang)} · {c.hours} {ru ? 'ч' : 'h'}</li>)}</ul>
      </div>
      <span class="preview__go" aria-hidden="true"><span class="arrow">↗</span></span>
    </a>
  </section>

  <!-- TESTIMONIALS (real letters, company only) -->
  <section class="container section">
    <div class="section-head"><div><span class="label label--line reveal">References</span><h2 class="reveal">{tr(copy.testimonials, lang)}</h2></div></div>
    <ul class="quotes">
      {testimonials.map((q) => (
        <li class="reveal"><figure class="quote"><blockquote>{tr(q.quote, lang)}</blockquote><figcaption>{tr(q.company, lang)}</figcaption></figure></li>
      ))}
    </ul>
  </section>

  <!-- FAQ (flip cards) -->
  <section class="container section">
    <div class="section-head">
      <div><span class="label label--line reveal">FAQ</span><h2 class="reveal">{ru ? 'Частые вопросы' : 'Frequently asked'}</h2></div>
      <a class="link reveal" href={href('faq', lang)}>{ru ? 'Все вопросы' : 'All questions'} <span class="arrow">↗</span></a>
    </div>
    <FaqFlip lang={lang} limit={6} id="home-faq" />
  </section>

  <MatchCards lang={lang} />

  <!-- CONTACT (as in the first portfolio) -->
  <ContactBlock lang={lang} />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-year]');
    const drop = document.querySelector<HTMLElement>('[data-drop]');
    const head = document.querySelector<HTMLElement>('[data-drop-head]');
    const items = document.querySelectorAll<HTMLElement>('[data-role-years]');
    if (!drop) return;
    tabs.forEach((btn) => btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      tabs.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (open) { drop.classList.remove('is-open'); return; }
      btn.setAttribute('aria-expanded', 'true');
      const y = btn.dataset.year ?? '';
      items.forEach((li) => { li.hidden = !(li.dataset.roleYears ?? '').split(',').includes(y); });
      if (head) head.textContent = y;
      drop.classList.add('is-open');
    }));
  });
</script>

<style>
  /* hero */
  .hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 5vw, 72px); align-items: center; padding-top: clamp(28px, 5vw, 64px); }
  .hero__title { font-size: var(--fs-hero); line-height: 0.92; letter-spacing: -0.035em; margin: 18px 0 26px; text-transform: uppercase; }
  .hero__line { display: block; white-space: nowrap; }
  .hero__title:lang(ru), :global(html[lang='ru']) .hero__title { font-size: clamp(2.9rem, 7.2vw, 7rem); }
  .hero__title .star { font-size: 0.42em; vertical-align: top; margin-left: 0.06em; }
  .hero .lead { max-width: 30rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero__visual { position: relative; }
  .hero__window { transform: rotate(1.2deg); }
  .hero__window :global(.hero__window-body) { padding: 0; }
  .hero__photo { width: 100%; aspect-ratio: 4 / 4.4; object-fit: cover; object-position: 50% 30%; }
  .hero__contacts { list-style: none; margin: 0; padding: 0; position: absolute; left: -28px; bottom: -22px; z-index: 2; display: grid; gap: 8px; justify-items: start; }
  .hero__contacts a {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px 0 8px; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--line-strong); box-shadow: var(--shadow-lift);
    text-decoration: none; font-size: 0.92rem; transition: background 0.2s, border-color 0.2s;
  }
  .hero__contacts a:hover { background: var(--berry); border-color: var(--berry); color: var(--lemon); }
  .hero__contacts .ico { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--berry); color: var(--lemon); font-size: 0.85rem; }
  .hero__contacts a:hover .ico { background: var(--lemon); color: var(--berry); }

  .hero__quote { display: flex; gap: 10px; align-items: flex-start; max-width: 28rem; margin: 22px 0 0; padding: 12px 16px 12px 0; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .hero__quote-mark { color: var(--berry); font: 3rem/0.8 var(--f-display); }
  .hero__quote p { margin: 0; color: var(--wine); font: 500 1.12rem/1.35 var(--f-display); letter-spacing: -0.01em; }

  /* folders */
  .folders { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--gap); list-style: none; margin: 0; padding: 24px 0 0; }
  .more__title { margin: var(--s-8) 0 var(--s-5); font-size: var(--fs-h3); }
  .more { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap); list-style: none; margin: 0; padding: 0; }
  .more > li { display: flex; }
  .more :global(.mw) { width: 100%; transition: transform var(--dur) var(--ease), border-color 0.3s; }
  .more :global(.mw:hover) { transform: translateY(-5px); border-color: rgba(204, 73, 100, 0.5); }
  .more :global(.mw__body) { display: grid; gap: 12px; align-content: start; }
  .mw__tag { justify-self: start; }
  .mw__role { margin-top: -6px; font-size: 0.88rem; color: var(--mink); }
  .mw__text { color: var(--text-soft); font-size: 0.95rem; }
